# MySQL Database Configuration (Sequelize)
DB_HOST=your-railway-db-host
DB_PORT=your-railway-db-port
DB_NAME=your-database-name
DB_USER=your-database-user
DB_PASSWORD=your-database-password

# MongoDB Configuration (Mongoose) - Optional for future NoSQL features
# MONGODB_URI=mongodb://localhost:27017/egytravel
# or MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/egytravel

# JWT Configuration (Single Token - No Expiration)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=365d

# Server Configuration
PORT=3000
NODE_ENV=production

# Email Configuration (for password reset)
# EMAIL_SERVICE=gmail
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password

# Security Configuration
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging Configuration
LOG_LEVEL=info


# Booking.com API Configuration
# Sign up at: https://www.booking.com/affiliate
BOOKING_API_BASE_URL=https://distribution-xml.booking.com/2.7/json
BOOKING_API_USERNAME=your-booking-api-username
BOOKING_API_PASSWORD=your-booking-api-password
BOOKING_AFFILIATE_ID=your-affiliate-id

# API Configuration
API_TIMEOUT=30000
API_RETRY_ATTEMPTS=2
API_RETRY_DELAY=1000

# Cache Configuration
CACHE_TTL_SEARCH=3600
CACHE_TTL_HOTEL=7200
CACHE_TTL_LOCATION=86400
